---
// src/components/MeetTheArtists.astro
// The "Meet the artists" section on the home page.
 
import { getCollection } from "astro:content";
import ArtistCard from "./ArtistCard.astro";
 
const allArtists = await getCollection("artists", ({ data }) => data.featured);
 
// Mockup shows a 3x2 grid (6 artists) on the home page.
// Swap this for pagination / "view all" once the roster grows past 6.
const featuredArtists = allArtists.slice(0, 6);
---
 
<section class="meet-artists">
  <div class="wrapper">
    <h2>Meet the artists</h2>
 
    <div class="meet-artists__grid">
      {featuredArtists.map((artist) => <ArtistCard artist={artist} />)}
    </div>
  </div>
</section>
 
<style>
  .meet-artists {
    background: #f0e9d7;
    padding: 4rem 0;
  }
 
  .meet-artists__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
    justify-content: space-between;
  }

</style>
 