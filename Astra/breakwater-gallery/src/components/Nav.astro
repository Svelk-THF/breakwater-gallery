---
// src/components/Nav.astro
 
const navItems = [
  { label: "The artists", href: "/artists" },
  { label: "About the gallery", href: "/about" },
  { label: "For supporters", href: "/supporters" },
  { label: "For artists", href: "/creative" },
  { label: "Contact us", href: "/contact" },
];
 
// Used to highlight the current section (compares the start of the path).
const currentPath = Astro.url.pathname;
---
 
<header class="site-nav">
  <div class="site-nav__inner">
    <a href="/" class="site-nav__logo" aria-label="The Breakwater Gallery — home">
      <!-- Swap for the real logo SVG/PNG from the brand guide when available -->
      <img src="/breakwater-gallery-logo-horiz.svg" alt="The Breakwater Gallery" width="180" height="48" />
    </a>
 
    <nav aria-label="Primary">
      <button
        class="site-nav__toggle"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-links"
      >
        <span class="sr-only">Menu</span>
        <span class="site-nav__toggle-bar"></span>
        <span class="site-nav__toggle-bar"></span>
        <span class="site-nav__toggle-bar"></span>
      </button>
 
      <ul class="site-nav__links" id="nav-links">
        {
          navItems.map((item) => {
            const isActive = currentPath.startsWith(item.href);
            return (
              <li>
                <a href={item.href} aria-current={isActive ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
 
<style>
  .site-nav {
    background: #ffffff;
  }
 
  .site-nav__inner {
    width: clamp(0px, 90%, 1240px);
    margin-inline: auto;
    padding-block: var(--space-m);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
 
  .site-nav__logo img {
    display: block;
    max-height: 60px;
    width: auto;
  }
 
  .site-nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-l);
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 25vw;
    background: white;
    z-index: 1000;
  }
 
  .site-nav__links a {
    font-family: "Proxima Nova", "Inter", sans-serif;
    font-size: var(--font-size--1);
    font-weight: 300;
    color: #var(--primary-mid-blue);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
 
  .site-nav__links a:hover,
  .site-nav__links a:focus-visible {
    color: var(--primary-dark-blue);
    border-bottom-color: var(--primary-mid-gold);
  }
 
  .site-nav__links a[aria-current="page"] {
    color: var(--primary-dark-blue);
    border-bottom-color: #var(--primary-mid-gold);
  }
 
  .site-nav__toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
  }
 
  .site-nav__toggle-bar {
    width: 22px;
    height: 2px;
    background: #1f2934;
  }
/*  
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  */
  /* Mobile: collapse into a hamburger menu */
  @media (max-width: 720px) {
    .site-nav__toggle {
      display: flex;
    }
 
    .site-nav__links {
      position: absolute;
      inset-inline: 0;
      left: auto;
      top: 100%;
      width: 100vw;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background: #ffffff;
      border-bottom: 1px solid #e5e0d5;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.2s ease;
    }
 
    .site-nav__links.is-open {
      max-height: 260px;
    }
 
    .site-nav__links li {
      width: 100%;
    }
 
    .site-nav__links a {
      display: block;
      width: 100%;
      padding: 1rem 2rem;
      border-bottom: none;
    }
 
    nav {
      position: relative;
    }
  }
</style>
 

<script>
  const toggle = document.getElementById("nav-toggle");
  const links = document.getElementById("nav-links");
 
  toggle?.addEventListener("click", () => {
    const isOpen = links?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });
</script>