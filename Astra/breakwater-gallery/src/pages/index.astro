---
import BaseLayout from "../layouts/BaseLayout.astro";
import MeetTheArtists from "../components/MeetTheArtists.astro";
import Logo from "../components/Logo.astro";

const { title } = Astro.props;
---

<BaseLayout title={"The Breakwater Gallery"}>
  <section aria-labelledby="hero" class="hero-section">
    <div class="wrapper">
      <div class="hero-area">
        <div class="grid-content">
          <h1 id="hero">
            A new destination for
            <span style="font-weight: 600; color: var(--primary-mid-blue);">
              local artwork</span
            > in Taranaki.
          </h1>
          <a href="#" class="btn-solid">About the gallery</a>
        </div>
        <div class="hero-img">
          <img
            src="/src/images/hero-image.png"
            alt="The Breakwater Gallery exterior"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="light-gold-background" aria-labelledby="intro">
    <div class="wrapper">
      <div class="two-col-grid">
        <div class="grid-content">
        <h2 id="intro">Introducing the gallery</h2>
        <p>
          The Breakwater Gallery is a new and exciting space for Taranaki.
          Situated on the Lee Breakwater at Port Taranaki, the gallery will
          showcase the region’s best outdoor artists, as well as being an
          opportunity for up-and-coming artists to show display their talent.
          The gallery will turn the grey and industrial area into a vibrant
          walkway that tells the story of our creative community, while also
          fundraising for local healthcare services.
        </p>
        </div>
        <div class="grid-img img-full-height">
          <img src="/src/images/Breawater-logo-mockup.jpeg" alt="Breakwater gallery logo on a bollard" />
        </div>
      </div>
    </div>
  </section>

    <section aria-labelledby="explain" class="wave-pattern">
      <div class="wrapper">
        <h2 id="explain">Be involved in something special</h2>
        <div class="two-col-grid">
          <div class="grid-content">
            <p class="grid-content">
              The Breakwater Gallery is funded entirely by the people of
              Taranaki. Local businesses, community groups, and individuals who
              understand the real, positive impact that creativity has on a
              region donate to enable our artists to create this space.
            </p>
            <p class="grid-content">
              We are looking for businesses who want to support this exciting
              project and support local creativity
            </p>
            <a href="#" class="btn-solid">Get involved</a>
          </div>
          <img
            src="/src//images/breakwater.jpg"
            alt="The Breakwater Gallery exterior"
            class="widescreen"
          />
        </div>
      </div>
    </section>

    <section>
    <MeetTheArtists />
    <Logo />
  </section>

  <style>
    .hero-section {
      position: relative;
    }

    .hero-area {
      position: relative;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }

    .hero-img img {
      width: 125%;
    }

    .hero-text {
      z-index: 100;
      align-self: start;
      justify-self: flex-start;
      padding: var(--space-m);
      color: white;
      max-width: 60%;
    }

    #hero {
      margin-block: var(--space-m);
    }
  </style>
</BaseLayout>
