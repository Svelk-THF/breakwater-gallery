---
// Renders one page per artist, generated from the same "artists" collection
// that MeetTheArtists.astro reads from — one source of truth, no prop-passing
// between pages needed.

import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const artists = await getCollection("artists");
  return artists.map((artist) => ({
    params: { slug: artist.id },
    props: { artist },
  }));
}

const { artist } = Astro.props;
const { name, photo, website, workImages } = artist.data;
const { Content } = await render(artist);
---

<BaseLayout title={`${name} — The Breakwater Gallery`}>
  <section class="wrapper artist-hero">
    <Image src={photo} alt={name} width={480} height={560} class="object-fit"/>
    <div>
      <h1>{name}</h1>
      <div class="artist-hero__bio">
        <Content />
      </div>
      {website && (
        <a class="button" href={website} target="_blank" rel="noopener noreferrer">
          Artists website
        </a>
      )}
    </div>
  </section>

  {workImages.length > 0 && (
    <section class="wrapper artist-work">
      <h2>{name}'s work</h2>
      <div class="artist-work__grid">
        {workImages.map((img) => (
          <Image src={img} alt={`Artwork by ${name}`} width={400} height={300} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .artist-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    padding-block: 3rem;
    align-items: start;
  }

  .artist-hero__bio {
    margin-bottom: 1.5rem;
  }

  .artist-work {
    padding-block: 3rem;
  }

  .artist-work__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .object-fit {
    /* width: 100%;
    height: 100%; */
    object-fit: cover;
  }
  @media (max-width: 800px) {
    .artist-hero {
      grid-template-columns: 1fr;
    }

    .artist-work__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>